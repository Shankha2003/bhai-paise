rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/sharedGroups/$(groupId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/groupInvites/$(code);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.memberUids;
    }

    function validJoin(groupId) {
      let code = resource.data.inviteCode;
      let before = resource.data.memberUids;
      let after = request.resource.data.memberUids;
      let inviteBefore = get(invitePath(code)).data;
      let inviteAfter = getAfter(invitePath(code)).data;
      return signedIn()
        && request.auth.uid in after
        && !(request.auth.uid in before)
        && after.size() == before.size() + 1
        && after.hasAll(before)
        && inviteBefore.groupId == groupId
        && inviteBefore.expiresAt > request.time
        && inviteAfter.groupId == groupId
        && request.auth.uid in inviteAfter.joinedUids
        && !(request.auth.uid in inviteBefore.joinedUids)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds);
    }

    match /sharedGroups/{groupId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberIds is list
        && request.resource.data.members is map
        && request.resource.data.expenses is map
        && request.resource.data.inviteCode is string
        && getAfter(invitePath(request.resource.data.inviteCode)).data.groupId == groupId
        && getAfter(invitePath(request.resource.data.inviteCode)).data.createdBy == request.auth.uid;

      allow update: if isMember(groupId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberUids'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'iconKey', 'members', 'memberIds', 'expenses', 'updatedAt'
        ])
        || validJoin(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberUids', 'members', 'memberIds', 'updatedAt'
          ]);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerUid == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteCode == code;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedUids'])
        && request.resource.data.groupId == resource.data.groupId
        && resource.data.expiresAt > request.time
        && request.resource.data.joinedUids.size() == resource.data.joinedUids.size() + 1
        && request.auth.uid in request.resource.data.joinedUids
        && !(request.auth.uid in resource.data.joinedUids)
        && request.auth.uid in getAfter(groupPath(resource.data.groupId)).data.memberUids;

      allow delete: if false;
    }

    match /userDevices/{userId}/tokens/{tokenId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
